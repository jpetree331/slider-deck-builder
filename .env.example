# Lantern — server environment. Copy to .env and fill in. The .env file is
# gitignored and NEVER leaves this machine; neither key is ever sent to the
# browser (Sacred Invariant 1 — all model calls happen server-side).

# ── API keys ────────────────────────────────────────────────────────────────

# Anthropic Console (https://console.anthropic.com) → API Keys → Create Key.
# Used ONLY for the outline model (Claude Haiku) — never sent to the browser.
ANTHROPIC_API_KEY=

# Google AI Studio (https://aistudio.google.com) → Get API key.
# gemini-3-pro-image-preview (Nano Banana Pro) requires a PAID-TIER key —
# a free-tier key will 4xx on this model. Never sent to the browser.
GEMINI_API_KEY=

# ── Service knobs (all optional — defaults shown) ───────────────────────────

# Port the FastAPI service listens on. 8020 is Lantern's claimed port
# (8000/8001/8002/8005/8007/8010 are taken by other services — see RUNBOOK.md).
LANTERN_PORT=8020

# Where decks live on disk. Relative paths resolve against the repo root.
# A deck is a folder: data/decks/<id>/deck.json + slides/*.png + exports/.
LANTERN_DATA_DIR=data

# Optional HTTP Basic auth password (username is ignored, any value works).
# When set, EVERYTHING — API, images, exports, the app itself — requires it.
# Leave empty on a trusted machine; SET IT before exposing over Tailscale.
LANTERN_PASSWORD=

# Outline model — writes the deck's art direction and per-slide image briefs.
# Provider-aware: gemini-* ids call Google over REST, claude-* ids call the
# Anthropic SDK. Owner reversal 2026-08-13 (DECISIONS.md): Gemini 3.1 Pro
# replaced Haiku here because it writes far more ambitious image briefs.
# To go back: LANTERN_OUTLINE_MODEL=claude-haiku-4-5-20251001
LANTERN_OUTLINE_MODEL=gemini-3.1-pro-preview

# Image model — Google model string for Nano Banana Pro. Pinned by Locked
# Decision 3; called over REST (no Google SDK). Same drift rule as above.
LANTERN_IMAGE_MODEL=gemini-3-pro-image-preview

# Server-side clamp on slides per deck — the cost guard. A 16-slide deck at
# 2K is roughly $2.20 of Gemini credit; raise this knowingly or not at all.
LANTERN_MAX_SLIDES=30

# ── Chalk (the chat tab) — all optional, defaults shown ─────────────────────

# Where the chat SQLite file lives. One file; the zip backup ritual covers it.
CHALK_DB_PATH=data/chalk.db

# Default model for new conversations. Options mirror
# dashboard/src/config/models.ts — THE model list; edit there to add models.
CHALK_DEFAULT_MODEL=claude-haiku-4-5

# Response cap per turn and history budget per request (characters).
CHALK_MAX_TOKENS=8192
CHALK_HISTORY_CHAR_BUDGET=100000
